# DB_TYPE bestimmt welche Datenbank verwendet wird.
# Werte: memory | postgres | mongo
# Kopiere diese Datei nach .env und passe die Werte an.

DB_TYPE=memory

# ── Frontend ────────────────────────────────────────────────────
# Pfad zum alu-chess-web Repo (relativ zu diesem docker-compose.yml oder absolut).
# Nur nötig, wenn du das Frontend-Profil startest:
#   docker compose --profile frontend up -d --build
FRONTEND_CONTEXT=../../SoftwarearchitekturWeb/alu-chess-web

# ── PostgreSQL (DB_TYPE=postgres) ──────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/chess
DB_USER=Username
DB_PASSWORD=Password

# ── MongoDB (DB_TYPE=mongo) ────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=Username

# ── Kafka ────────────────────────────────────────────────────────
# Docker Compose verwendet den Service-Namen kafka.
# Lokal ausserhalb von Docker ist localhost:9092 der Default im Code.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_MOVES=chess-moves
KAFKA_TOPIC_AI_REQUESTS=chess-ai-requests
KAFKA_TOPIC_AI_RESPONSES=chess-ai-responses
KAFKA_AI_WORKER_GROUP_ID=alu-chess-ai-workers
KAFKA_TOPIC_STOCKFISH_REQUESTS=stockfish-engine-requests
KAFKA_TOPIC_STOCKFISH_RESPONSES=stockfish-engine-responses
KAFKA_STOCKFISH_WORKER_GROUP_ID=alu-chess-stockfish-workers
ENGINE_TRANSPORT=kafka
STOCKFISH_POOL_SIZE=2
AI_TIME_LIMIT_MS=2000
AI_MAX_DEPTH=4
