FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1
ENV STOCKFISH_PATH=/usr/games/stockfish

WORKDIR /app

RUN apt-get update \
	&& apt-get install -y --no-install-recommends stockfish \
	&& rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY model/src/main/scala/chess/model/api/StockfishEngineAPI.py /app/StockfishEngineAPI.py
COPY model/src/main/scala/chess/model/api/StockfishKafkaWorker.py /app/StockfishKafkaWorker.py

CMD ["python", "StockfishKafkaWorker.py"]
